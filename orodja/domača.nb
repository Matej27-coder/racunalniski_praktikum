Cell[BoxData[{
 RowBox[{"ClearAll", "[", "x", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vrednostSin", "[", "x_", " ", "]"}], ":=", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Numeri\[CHacek]na vrednost sin(\>\"", ",", "x", 
    ",", "\"\<) je enaka \>\"", ",", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], ",", "7"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Infinity", ",", "7"}], "}"}]}], "]"}]}], "]"}]}], "\n", 
 RowBox[{"vrednostSin", "[", 
  RowBox[{
   RowBox[{"-", "Pi"}], "/", "4"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "[", "x", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"x", "^", "4"}], " ", "-", " ", 
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "-", "1"}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"g", "[", "6", "]"}], "\[IndentingNewLine]", 
 RowBox[{"sez", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"i", "+", "1"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "9"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Mean", "[", "sez", "]"}], "\[IndentingNewLine]", 
 RowBox[{"sez1000", "=", 
  RowBox[{"Select", "[", 
   RowBox[{"sez", ",", 
    RowBox[{
     RowBox[{"#", "<", "1000"}], "&"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"g", ",", "sez", ",", "sez1000"}], "]"}], ";"}], "\n", 
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "^", "4"}], "-", 
      RowBox[{
       RowBox[{"E", "^", "i"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"i", "^", "2"}], "-", "1"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2", ",", "10"}], "}"}]}], "]"}], ",", 
   RowBox[{
    RowBox[{"#", "<", "1000"}], "&"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "[", 
  RowBox[{"n", ",", " ", "a"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"RecurrenceTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", "n", "]"}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"n", "-", "1"}], "]"}], "+", 
           RowBox[{"a", "[", 
            RowBox[{"n", "-", "2"}], "]"}]}], ")"}], "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"a", "[", "1", "]"}], "==", 
        RowBox[{"-", "2"}]}], ",", 
       RowBox[{
        RowBox[{"a", "[", "2", "]"}], "==", 
        RowBox[{
         RowBox[{"-", "2"}], "/", "3"}]}]}], "}"}], ",", "a", ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "10"}], "}"}]}], "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{" "}]}], "Input",
