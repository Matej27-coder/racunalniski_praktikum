  3.9828098118746634`*^9}},ExpressionUUID->"d08268d6-b24f-4df6-8867-\
b7106f8736ed"],

Cell["\<\
b) Izra\[CHacek]unaj vrednost `izraz`-`izraz1` in dobljeno \[SHacek]tevilo \
\[CHacek]im bolj poenostavi. Nato izra\[CHacek]unaj numeri\[CHacek]no \
vrednost dobljenega \[SHacek]tevila na 15 decimalnih mest natan\[CHacek]no.\
\>", "Text",
 CellChangeTimes->{{3.9195881603642406`*^9, 3.919588172591969*^9}, {
  3.98274874727958*^9, 3.982748772724862*^9}, {3.9827494007240143`*^9, 
  3.9827494089875927`*^9}, {3.9828115739979973`*^9, 
  3.9828115815650883`*^9}},ExpressionUUID->"9804671c-ec4a-4f81-9cd6-\
56ade1224cc6"],

Cell[TextData[{
 "c) Definiraj funkcijo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c375f561-b3e3-4370-ab61-ce09e6ceb0d7"],
 ", ki kot argument sprejme realno \[SHacek]tevilo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "651aa032-397b-4964-b325-68c7e699a3fa"],
 " in vrne numeri\[CHacek]no vrednost `(izraz+izraz1)/izraz2` pri x=n. Izra\
\[CHacek]unaj f(2)."
}], "Text",
 CellChangeTimes->{{3.9195881603642406`*^9, 3.919588172591969*^9}, {
  3.9827488632981696`*^9, 3.9827489018415103`*^9}, {3.9827490230998254`*^9, 
  3.982749031364417*^9}, {3.982776832712474*^9, 3.9827768371045647`*^9}, {
  3.982811599299813*^9, 
  3.9828115995549927`*^9}},ExpressionUUID->"bcfa8760-018d-477d-a1c1-\
2b0a58b165c9"],

Cell[TextData[{
 "d) Za funkcijo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff81c459-918e-41f9-8bc4-9275c4771e38"],
 " iz dela c) poenostavi izraz ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["log", "3"], "(", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["x", "TI"], "2"], "-", "8", 
                   StyleBox["x", "TI"], 
                   StyleBox["z", "TI"], "+", "3", 
                   StyleBox["y", "TI"]}], ")"}], "-", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["x", "TI"], "-", "3"}], ")"}], "2"]}], ")"}], 
           "]"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "f[\\log_3((x^2 -8x z+ 3y)- (x - 3)^2)]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c18d1080-3736-4975-b36a-5b140b6e802f"],
 " za x = 6, y = -1/2 in z = -1."
}], "Text",
 CellChangeTimes->{{3.919588196740964*^9, 3.919588203635347*^9}, {
  3.9827491560264874`*^9, 3.982749163539364*^9}, {3.982749301596506*^9, 
