  3.919588073912944*^9}, {3.9195881768486853`*^9, 3.9195882263675756`*^9}, {
  3.982748289791173*^9, 3.982748329571271*^9}, {3.9827483687913857`*^9, 
  3.98274838365839*^9}, {3.9827486152861834`*^9, 3.9827486586670637`*^9}, {
