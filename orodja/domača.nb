Cell[BoxData[{
 RowBox[{"izraz", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"10", ",", " ", "E"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"Pi", "/", "4"}], "]"}], "^", "2"}], ")"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "+", "2"}], ")"}], "/", "10"}], "+", "x"}]}], "\[IndentingNewLine]", 
 RowBox[{"izraz1", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Log", "[", "E", "]"}], "/", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", "/", "4"}], "]"}], "^", "2"}]}], " ", "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "+", "2"}], ")"}], "/", "10"}], "+", "x"}]}], "\[IndentingNewLine]", 
 RowBox[{"izraz2", " ", "=", " ", 
  RowBox[{"izraz", " ", "/.", " ", 
   RowBox[{"x", "->", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "+", "1"}], ")"}], "^", "2"}]}]}]}], "\[IndentingNewLine]", 
