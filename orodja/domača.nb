   3.982811781581925*^9}},ExpressionUUID->"b454df6a-5b81-41af-9cea-\
4fbaf663e159"],

Cell[TextData[{
 "b) Definiraj anonimno funkcijo g (s parametrom #) s predpisom ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "4"], "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["x", "TI"]], 
          RowBox[{
            SuperscriptBox[
             StyleBox["x", "TI"], "2"], "-", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g(x) = x^4-\\frac{e^x}{x^2-1}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d445716-44a4-4013-90a2-8c8cc74f92b5"],
 ". Izra\[CHacek]unaj g(6)."
}], "Text",
