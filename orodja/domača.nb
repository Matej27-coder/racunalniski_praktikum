  3.982810512595291*^9}},ExpressionUUID->"7f45d31c-dd94-4238-bc32-\
1d18b39927df"],

Cell[TextData[{
 "a) Definiraj funkciji ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "6"], "-", "6", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "+", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "g(x)= x^6 - 6x^2 + 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3be41a48-7b75-400f-9332-5e1f01ed4a94"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "sin", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["x", "TI"], "4"], "-", "2"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> "h(x)=\\sin(x^4-2)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "edb0e68c-2235-404e-af28-64660d448b74"],
 ". Nato nari\[SHacek]i njuna grafa na intervalu [-2,2] v isti koordinatni \
sistem."
}], "Text",
 CellChangeTimes->{{3.9194925508565483`*^9, 3.919492568117846*^9}, {
  3.9194926118652563`*^9, 3.919492629232089*^9}, {3.91949275900605*^9, 
  3.919492785764957*^9}, {3.9194928162611313`*^9, 3.9194928355248623`*^9}, {
  3.91949287749646*^9, 3.919492936455954*^9}, {3.982810547328392*^9, 
  3.982810564067917*^9}, {3.9828107545753407`*^9, 
  3.982810767278718*^9}},ExpressionUUID->"766bc23c-bac8-488d-bd81-\
4d17bbbda28a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"x", "^", "6"}], " ", "-", 
    RowBox[{"6", " ", 
     RowBox[{"x", "^", "2"}]}], " ", "+", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], ":=", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{
     RowBox[{"x", "^", "4"}], "-", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", "[", "x", "]"}], ",", " ", 
     RowBox[{"h", "[", "x", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "2"}], ",", " ", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.983355684590353*^9, 3.9833557989047337`*^9}, {
