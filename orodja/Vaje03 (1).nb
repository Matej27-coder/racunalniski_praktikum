  3.919322082012895*^9}},ExpressionUUID->"be69bd61-b0ef-4752-bce9-\
227644e8d8fe"],

Cell[TextData[{
 "Napi\[SHacek]i  funkcijo quickSort, ki sprejme seznam in vrne urejen \
seznam. Za urejanje naj uporabi algoritem ",
 StyleBox["Quick sort",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.919321974718964*^9, 3.919322032589476*^9}, {
  3.9816527618300543`*^9, 
  3.9816527736932373`*^9}},ExpressionUUID->"90c84ab9-ce97-483d-ade2-\
613fa46deddc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"quickSort", "[", 
   RowBox[{"{", "}"}], "]"}], ":=", 
  RowBox[{"{", "}"}]}], "\n", 
 RowBox[{
  RowBox[{"quickSort", "[", 
   RowBox[{"{", 
    RowBox[{"pivot_", ",", "rest___"}], "}"}], "]"}], ":=", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"quickSort", "[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"{", "rest", "}"}], ",", 
       RowBox[{
        RowBox[{"#", "<", "pivot"}], "&"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", "pivot", "}"}], ",", 
    RowBox[{"quickSort", "[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"{", "rest", "}"}], ",", 
       RowBox[{
        RowBox[{"#", ">=", "pivot"}], "&"}]}], "]"}], "]"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{3.983285428188078*^9},
 CellLabel->"In[72]:=",ExpressionUUID->"7ddc6ed4-a1c0-8046-9148-1ef7ab392689"],

