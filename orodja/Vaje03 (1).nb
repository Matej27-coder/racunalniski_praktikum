Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"NarisiKroge", "[", "n_", "]"}], ":=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Disk", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", " ", "i"}], ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"NarisiKroge", "[", "5", "]"}], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "n", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MesaniKroge", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"colors", "=", 
        RowBox[{"{", 
         RowBox[{"Green", ",", "Blue", ",", "Red"}], "}"}]}], "}"}], ",", 
      RowBox[{"Graphics", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"colors", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", 
                RowBox[{"Length", "[", "colors", "]"}]}], "]"}], "+", "1"}], 
             "]"}], "]"}], ",", 
           RowBox[{"Disk", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", " ", "i"}], ",", "0"}], "}"}], ",", "1"}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"MesaniKroge", "[", "5", "]"}], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "n", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NarisiKrogle", "[", "n_", "]"}], ":=", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Specularity", "[", 
        RowBox[{"White", ",", "20"}], "]"}], ",", "Orange", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", " ", "i"}], ",", "i", ",", "0"}], "}"}], ",", "1"}],
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"NarisiKrogle", "[", "3", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "y1", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "y2", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"6", ",", "y3", ",", "0"}], "}"}], ",", "1"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "8"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"y1", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y2", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y3", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}], 
