Cell[TextData[{
 "Napi\[SHacek]i funkcijo, ki sprejme narvni \[SHacek]tevili m in n in vrne \
seznam prvih n \[CHacek]lenov ",
 StyleBox["Collatzovega zaporedja",
  FontSlant->"Italic"],
 " za \[SHacek]tevilo m. Pomagaj si s funkcijo \
\[OpenCurlyDoubleQuote]RecurrenceTable\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{
  3.918737113432963*^9, {3.918737191383535*^9, 3.918737307637512*^9}, {
   3.918738735534246*^9, 3.918738861279017*^9}, {3.918738963334521*^9, 
   3.918738969546136*^9}, {3.918739007050296*^9, 3.9187390134649553`*^9}, {
   3.918739651116387*^9, 
   3.918739676738667*^9}},ExpressionUUID->"143bf3ee-2d9b-4676-8304-\
224af6927c5d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "n", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Collatz", "[", 
   RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"RecurrenceTable", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", 
        RowBox[{"i", "+", "1"}], "]"}], "==", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"EvenQ", "[", 
          RowBox[{"a", "[", "i", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"a", "[", "i", "]"}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"3", " ", 
           RowBox[{"a", "[", "i", "]"}]}], "+", "1"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"a", "[", "1", "]"}], "==", "m"}]}], "}"}], ",", "a", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Collatz", "[", 
  RowBox[{"10", ",", " ", "5"}], "]"}]}], "Input",
 CellChangeTimes->{{3.983285337403761*^9, 3.983285386587782*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"628c8729-0e18-3548-b3e7-0a12b997d2d9"],

Cell[BoxData[
 RowBox[{"{", 
