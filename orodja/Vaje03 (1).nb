Cell["\<\
Napi\[SHacek]i funkcijo odvod polinoma, ki kot argument sprejme polinom v \
splo\[SHacek]ni obliki in vrne njegov odvod. Pri tem uporabi le prepisovalna \
pravila.\
\>", "Text",
 CellChangeTimes->{{3.9193112929158688`*^9, 
  3.919311365620349*^9}},ExpressionUUID->"5ad1cd3f-909e-4261-884a-\
2929e2fee6b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"odvodPolinoma", "[", "polinom_", "]"}], ":=", 
  RowBox[{"polinom", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x_", "^", "n_."}], ":>", 
      RowBox[{"n", "*", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"c_", "*", "x_"}], ":>", "c"}], ",", 
     RowBox[{
      RowBox[{"c_", "?", "NumericQ"}], ":>", "0"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"odvodPolinoma", "[", 
  RowBox[{
   RowBox[{"x", "^", "3"}], " ", "+", " ", 
   RowBox[{"x", "^", "2"}], "+", 
   RowBox[{"5", "x"}]}], "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.983285460330168*^9, 3.983285512472763*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"425595b3-59cc-224d-ac2e-112ef166f6fc"],

