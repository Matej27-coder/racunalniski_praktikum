      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", "\"\<y\>\"", ",", 
        " ", "\"\<f(x, y, z)\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Mesh", "->", "None"}], ",", " ", 
     RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}]}], "]"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "0", ",", " ", 
     RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9834537172265587`*^9, 3.983453834399431*^9}, {
  3.983453870841818*^9, 3.983453871264265*^9}, {3.9834539143777676`*^9, 
