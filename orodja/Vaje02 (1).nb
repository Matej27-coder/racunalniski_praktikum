Cell[BoxData[{
 RowBox[{
  RowBox[{"poenostaviInIzpisi", "[", "izr_", "]"}], ":=", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Izraz\>\"", ",", 
    RowBox[{"ToString", "[", 
     RowBox[{"izr", ",", "TraditionalForm"}], "]"}], 
    ",", "\"\<se poenostavi v izraz\>\"", ",", 
    RowBox[{"ToString", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", "izr", "]"}], ",", "TraditionalForm"}], 
     "]"}], ",", 
    RowBox[{"\"\<.\>\"", 
     RowBox[{"FullSimplify", "[", "izr", "]"}]}]}], " ", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"poenostaviInIzpisi1", "[", "izr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "poenostavljenIzraz", "}"}], ",", 
    RowBox[{
     RowBox[{"poenostavljenIzraz", "=", 
      RowBox[{"FullSimplify", "[", "izr", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<Izraz \>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"izr", ",", "TraditionalForm"}], "]"}], 
